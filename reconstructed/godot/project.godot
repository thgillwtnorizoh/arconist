config_version=5

[application]
config/name="Arconist R004 - 3D Tap and Hold Practice"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=740
window/size/window_width_override=1100
window/size/window_height_override=740
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Arconist.Godot"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035,0.045,0.075,1)

[audio]
driver/enable_input=false
